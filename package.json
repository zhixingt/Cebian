{
  "name": "CebianX",
  "description": "CebianX · 教务智能助手 — 浏览器侧边栏 AI 智能体。Forked from maotoumao/Cebian (AGPL-3.0)。",
  "private": true,
  "version": "1.3.1",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && node scripts/scan-obfuscation.mjs .output/chrome-mv3",
    "build:firefox": "wxt build -b firefox && node scripts/scan-obfuscation.mjs .output/firefox-mv2",
    "zip": "wxt zip && node scripts/scan-obfuscation.mjs .output/chrome-mv3",
    "zip:firefox": "wxt zip -b firefox && node scripts/scan-obfuscation.mjs .output/firefox-mv2",
    "compile": "tsc --noEmit",
    "check": "wxt prepare && tsc --noEmit && node scripts/lint-i18n.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "wxt prepare && simple-git-hooks",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:headed": "playwright test --config e2e/playwright.config.ts --headed",
    "test:auto": "node scripts/run-e2e-suite.mjs",
    "test:auto:resume": "node scripts/run-e2e-suite.mjs --resume",
    "test:auto:list": "node scripts/run-e2e-suite.mjs --list"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm check && pnpm lint"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@earendil-works/pi-agent-core": "^0.79.6",
    "@earendil-works/pi-ai": "^0.79.6",
    "@isomorphic-git/lightning-fs": "^4.6.2",
    "@lezer/highlight": "^1.2.3",
    "@mcp-ui/client": "^7.1.1",
    "@modelcontextprotocol/ext-apps": "^1.7.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "@wxt-dev/i18n": "^0.2.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "dexie": "^4.4.2",
    "fflate": "^0.8.2",
    "front-matter": "^4.0.2",
    "lucide-react": "^1.8.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^5.7.284",
    "picomatch": "^4.0.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-arborist": "^3.4.3",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "tw-animate-css": "^1.4.0",
    "typebox": "^1.1.33",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.1.40",
    "@types/isomorphic-git__lightning-fs": "^4.4.8",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "@wxt-dev/module-react": "^1.1.5",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "shadcn": "^4.2.0",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8",
    "wxt": "^0.20.20"
  }
}
